    "@types/chrome": "^0.2.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@wxt-dev/module-react": "^1.0.0",
    "eslint": "^9",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "wxt": "^0.20",
    "xlsx": "^0.18.5"
